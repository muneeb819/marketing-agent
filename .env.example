# ===== LLM PROVIDER =====
# Choose: openai | anthropic | ollama  (ollama = free, runs locally, no key)
LLM_PROVIDER=ollama

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Ollama (local, free) — install from https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ===== AGENT IDENTITY =====
AGENT_NAME=MarketingOps Agent
BUSINESS_NICHE=  # e.g. "social media marketing for small businesses"
BRAND_VOICE=professional, friendly, concise
CURRENCY=USD

# ===== STORAGE / SERVER =====
DATA_DIR=data
DB_PATH=data/memory.db
HOST=0.0.0.0
PORT=8000

# ===== WEB UI AUTH (leave empty to disable) =====
WEB_PASSWORD=

# ===== UPWORK API (read-only job feed) =====
# Create an app at https://www.upwork.com/developer/api (OAuth2).
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=http://localhost:8000/callback
UPWORK_ACCESS_TOKEN=

# ===== BUFFER (official social scheduling) =====
# Connect your social accounts at https://buffer.com, then set an access token.
BUFFER_ACCESS_TOKEN=

# ===== MORNING BRIEF DELIVERY (optional) =====
DIGEST_WEBHOOK=        # e.g. a Slack/Discord/Mattermost incoming webhook URL
DIGEST_EMAIL_TO=       # email address to send the daily brief to
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
